# ── DB（サーバサイド専用・NEXT_PUBLIC_ 禁止）──
# Prisma は任意の PostgreSQL で動作。DATABASE_URL=実行時(プール)、DIRECT_URL=マイグレーション(非プール)。
#
# Prisma は POSTGRES_PRISMA_URL(プール・実行時) と POSTGRES_URL_NON_POOLING(非プール・マイグレーション) を読む。
#
# ● Vercel Postgres / Neon: Storage連携で両変数が自動注入されるので**手動設定不要**。そのままデプロイ可。
# ● ローカル Postgres: 下記のように両方へ同じURLを設定（DATABASE_URL/DIRECT_URLは任意・スクリプト互換用）。
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:5432/dgloss_dig?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/dgloss_dig?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dgloss_dig?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/dgloss_dig?schema=public"

# apps/web でも同じ値が必要（Next ランタイムが読む）。
# → apps/web/.env にも同値を置くか、Vercel 環境変数で設定する。

# ── jinjer（勤怠）連携：従業員マスタ自動同期（サーバ専用）──
# 未設定時はサンプルで動作。設定すると api.jinjer.biz から実取得。
# JINJER_API_KEY=<X-API-KEY>
# JINJER_SECRET_KEY=<X-SECRET-KEY>
# JINJER_API_BASE=https://api.jinjer.biz

# ── 外部連携（SP_CRM）Supabase 直結（サーバ専用）──
# 詳細は docs/接続情報依頼_Supabase.md。未設定時はサンプルデータで動作。
# SPCRM_SUPABASE_URL=https://<ref>.supabase.co
# SPCRM_SUPABASE_KEY=<service_role or anon key>

# ── 契約管理DB（keiyaku-kanri-next）読み取り専用 直結（サーバ専用）──
# CG-CRM（dgloss-cg）と同一方式・同一の値を使う。読み取り専用ロールの接続URLのみ。
# 未設定なら契約同期は no-op（手入力で動作）。契約管理DBへは一切書き込まない（SELECTのみ）。
# CONTRACT_DB_URL=postgresql://cg_readonly:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
# 参照するVIEW名（既定 cg_customer_master）。
# CONTRACT_VIEW=cg_customer_master
# VIEWに事業部列が無いため、課金形態から判定できない契約に割り当てる既定の事業部。
# CONTRACT_DEFAULT_DIVISION=AIテレアポ事業部

# ── アカウント一括発行（従業員マスタ → ユーザー権限アカウント）──
# jinjer から会社メールが取れない人に使う仮メールのドメイン（既定 dgloss.co.jp）。
# ACCOUNT_EMAIL_DOMAIN=dgloss.co.jp

# ── 認証（Supabase Auth / Google・社内ドメイン制限）──
# NEXTAUTH_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── 認証（Google / Auth.js・社内ドメイン限定）──
# 3つ揃ったときだけ認証が有効になる（未設定の間は従来どおり認証なしで動作）。
# Google Cloud の OAuth 2.0 クライアント（種別=ウェブアプリ）を作成し、
# 承認済みリダイレクトURI に https://<本番ドメイン>/api/auth/callback/google を登録する。
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_SECRET は JWT の署名鍵。`openssl rand -base64 32` で生成。
# AUTH_SECRET=
# ログインを許可するメールドメイン（カンマ区切り・既定 dgloss.co.jp）。
# CG_AUTH_ALLOWED_DOMAINS=dgloss.co.jp
# Vercel Cron（契約管理DB同期）がサインイン無しで実行できるようにする共有シークレット。
# Vercel の Cron 設定と同じ値を入れる。未設定なら認証有効時に Cron はブロックされる。
# CRON_SECRET=

# ── Basic 認証（暫定ゲート・Google認証を用意するまでの保護）──
# 両方セットしたときだけ有効。Google認証（上記3つ）が有効な場合はそちらが優先される。
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=

# ── 権限切替セレクタ（動作確認用）──
# 認証が未設定のときに限り、ヘッダーで権限を切り替えられるようにする。
# 既定は非表示（＝ユーザー権限固定）。本番では設定しないこと。
# NEXT_PUBLIC_ALLOW_ROLE_SWITCH=true
