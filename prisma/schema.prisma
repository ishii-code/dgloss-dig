// Dig制度 データモデル（要件定義 §6）
// DB: Supabase(PostgreSQL) / ORM: Prisma。金額は Decimal で保持。
generator client {
  provider = "prisma-client-js"
  // Vercel Functions（Amazon Linux）で動くよう本番ターゲットを同梱
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // 実行時（Prisma Client）はプール接続。Vercel Postgres/Neon が自動注入する POSTGRES_PRISMA_URL を使用。
  url = env("POSTGRES_PRISMA_URL")
  // マイグレーション用の直結（非プール）。Vercel Postgres の POSTGRES_URL_NON_POOLING。
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

/// Dig獲得ルール（事業部別・要件 F-3）
model CalcRule {
  id             String       @id
  division       String
  name           String
  ruleType       CalcRuleType
  modelKeyFilter String?
  unitLine       Decimal      @default(0) @db.Decimal(14, 2)
  unitCall       Decimal      @default(0) @db.Decimal(14, 2)
  ratioPercent   Decimal      @default(0) @db.Decimal(7, 2)
  fixedDig       Decimal      @default(0) @db.Decimal(14, 2)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([division])
}

/// 契約（keiyaku-kanri-next から取込んだキャッシュ・要件 F-3）
model Contract {
  id           String              @id // keiyaku contract id
  contractNo   String?
  customerName String
  companyId    String? // 企業ID（SP_CRM 取引先参照・担当者自動帰属に使用）
  division     String
  modelKey     String
  status       String
  baseAmount   Decimal             @db.Decimal(14, 2)
  setupFee     Decimal             @default(0) @db.Decimal(14, 2)
  initialFee   Decimal             @default(0) @db.Decimal(14, 2)
  termMonths   Int                 @default(0)
  startDate    DateTime?           @db.Date
  lineItems    Json // ContractLineItem[]
  yearMonth    String // 反映対象月
  createdAt    DateTime            @default(now())
  assignment   ContractAssignment?

  @@index([division])
  @@index([yearMonth])
}

/// 契約→従業員のDig帰属（折半対応・SFA担当者から初期化／手動修正可・要件 F-3）
model ContractAssignment {
  contractId String   @id
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  source     String // sfa / manual
  shares     Json // AssignmentShare[] {personId, sharePercent}
  updatedAt  DateTime @updatedAt
}

/// 改善リクエスト（機能改善の投稿・対応管理）
model FeatureRequest {
  id        Int      @id @default(autoincrement())
  title     String
  body      String?
  category  String   @default("機能改善")
  status    String   @default("未対応")
  page      String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// 監査ログ（設定変更・借入承認・送金・金利変更等の操作記録・要件 §10）
model AuditLog {
  id        Int      @id @default(autoincrement())
  actor     String // 操作者（Person ID or システム）
  action    String // 例: loan.approve / setting.rate.update / bonus.create
  entity    String // 対象エンティティ
  entityId  String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

enum EmploymentType {
  正社員
  アルバイト
}

enum EvaluationCycle {
  四半期
  半期
}

enum Position {
  部長
  マネージャー
  リーダー
  メンバー
}

enum JobType {
  FS
  IS
  CS
}

enum Rank {
  S
  A
  B
  C
  D
}

enum MemberStatus {
  在籍
  退社
}

enum LoanType {
  初回
  追加
}

enum LoanStatus {
  申請中
  差し戻し
  承認済
  却下
  完済
}

enum CalcRuleType {
  回線コール単価
  初回発注1to1
  月額基本料金割合
  固定Dig
  バーター契約
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

/// アカウント（RBAC）。SUPER_ADMIN のみ金融承認・従業員マスタ・アカウント管理にアクセス可。
model Account {
  id        String   @id // メール等
  email     String   @unique
  name      String
  role      Role     @default(USER)
  personId  String? // 従業員マスタとの紐付け（任意）
  active    Boolean  @default(true)
  /// パスワードのハッシュ（scrypt・平文は保存しない）。未設定はパスワードログイン不可
  passwordHash String?
  /// 仮パスワードの状態。true なら初回ログイン時にパスワード変更を強制する
  mustChangePassword Boolean @default(false)
  /// 最終ログイン日時（運用確認用）
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}


/// 組織（事業部 > グループ > チーム）。事業部名の自由記入をやめ、ここで一元管理する。
model OrgUnit {
  id        Int      @id @default(autoincrement())
  name      String
  /// 階層。事業部 / グループ / チーム
  level     String
  parentId  Int?
  parent    OrgUnit?  @relation("OrgTree", fields: [parentId], references: [id])
  children  OrgUnit[] @relation("OrgTree")
  /// この組織の長（配下メンバーの予算Digを合算する対象）。Member.personId
  leaderId  String?
  /// Dig評価の対象か。自分または祖先が対象なら配下は全員対象になる
  isTarget  Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members Member[]

  @@index([parentId])
  @@index([level])
}

/// jinjer の役職名 → Dig評価の役職 の紐付け（所属の紐付けと同じ考え方）
model PositionRule {
  id        Int      @id @default(autoincrement())
  /// jinjer 上の役職名（完全一致）
  pattern   String   @unique
  position  Position
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 月次の実労働時間（jinjer の打刻実績）。アルバイトの予算Dig算定に使う
model WorkHours {
  yearMonth String // YYYY-MM
  personId  String
  /// その月の実労働時間（時間）
  hours     Decimal  @db.Decimal(8, 2)
  source    String   @default("jinjer")
  updatedAt DateTime @updatedAt

  @@id([yearMonth, personId])
  @@index([yearMonth])
}

/// 設定マスタ（要件 F-1）。対象年月ごとに1レコード（履歴保持）。
model Setting {
  yearMonth            String   @id // YYYY-MM
  insuranceCoefficient Decimal  @db.Decimal(6, 3)
  budgetCoefficient    Decimal  @db.Decimal(6, 3)
  annualRatePct        Decimal  @db.Decimal(6, 3)
  initialLoanDefault   Decimal  @db.Decimal(14, 2)
  loanTermMonthsDefault Int     @default(12)
  commonCostFulltime   Decimal  @db.Decimal(12, 2)
  commonCostParttime   Decimal  @db.Decimal(12, 2)
  promotionUpTwo       Decimal  @db.Decimal(5, 3)
  promotionUpOne       Decimal  @db.Decimal(5, 3)
  promotionDownOne     Decimal  @db.Decimal(5, 3)
  promotionDownTwo     Decimal  @db.Decimal(5, 3)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// 給与レンジ（役職 × ランク）
model SalaryRange {
  id       Int      @id @default(autoincrement())
  position Position
  grade    String // A / B / C
  amount   Decimal  @db.Decimal(12, 2)

  @@unique([position, grade])
}

/// jinjer の末端所属名 → dgloss 事業部 の紐づけルール（前方一致）。
/// 例: 「ダイレクトセールス部セールスG」→「AIテレアポ事業部」
model DivisionRule {
  id        Int      @id @default(autoincrement())
  pattern   String   @unique /// jinjer 所属名（前方一致で判定）
  division  String /// dgloss 側の事業部名
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Dig制度の対象事業部。登録された事業部のメンバーだけが評価対象になる。
model TargetDivision {
  division  String   @id
  createdAt DateTime @default(now())
}

/// 予算Digの月別上書き（運用で個別に予算を指定する場合）。
/// 設定されていれば計算値より優先される。
model BudgetOverride {
  yearMonth        String
  personId         String
  monthlyBudgetDig Decimal  @db.Decimal(14, 2)
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@id([yearMonth, personId])
  @@index([yearMonth])
}

/// Dig申請（成果Digの申請・承認）。契約1件ごとに申請し、承認で成果Digへ計上する。
model DigApplication {
  id              Int       @id @default(autoincrement())
  applicantId     String /// 申請主（Person ID）
  companyId       String? /// 顧客ID（契約管理DB/SP_CRM の企業ID）
  companyName     String /// 企業名
  productName     String /// 商材（例: AIテレアポ）
  contractSummary String? /// 契約内容（例: 3ヵ月プラン）
  contractId      String? /// 契約管理DBの契約ID（引当時）
  grantedDig      Decimal   @db.Decimal(14, 2) /// 獲得ポイント(D)
  splitDig        Decimal   @default(0) @db.Decimal(14, 2) /// 折半ポイント(D)
  splitPartnerId  String? /// 折半相手（Person ID）
  contractDate    DateTime  @db.Date /// 契約日
  note            String?
  status          String    @default("申請中") /// 申請中 / 承認済 / 却下
  reviewedBy      String?
  reviewedOn      DateTime?
  rejectReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([applicantId])
  @@index([status])
}

/// メンバーマスタ（要件 F-2）。personId は手入力の Person ID（v1.1 Q4）。
model Member {
  personId        String          @id
  name            String
  /// 会社メール（jinjer 由来）。アカウント発行の宛先に使う
  email           String?
  division        String
  /// jinjer 上の末端所属名（紐づけ再適用の原本）
  jinjerTeam      String?
  /// 所属する組織（事業部/グループ/チームのいずれか）。division はこの祖先の事業部名
  orgUnitId       Int?
  orgUnit         OrgUnit?        @relation(fields: [orgUnitId], references: [id])
  /// jinjer 上の役職名（紐づけの原本）
  jinjerPosition  String?
  /// 役職を一覧で手入力した。true なら紐づけルールで上書きしない
  positionManual  Boolean         @default(false)
  /// 役職ベースを一覧で手入力した。true ならレンジ自動判定で上書きしない
  positionBaseManual Boolean      @default(false)
  /// 配下（組織の長のとき）の合算方法。なし / 予算のみ / 予算と実績
  aggregateMode   String          @default("予算のみ")
  /// 個別に指定した事業部。設定時は同期・ルール適用より優先される
  divisionOverride String?
  /// 給与テーブルの等級（A〜G）。役職ベースの算定元
  salaryGrade     String?
  /// 給与テーブルの行（1〜9=上/0=基準/10〜18=下）
  salaryRow       Int?
  position        Position
  jobType         JobType?
  groupLeaderId   String?
  employmentType  EmploymentType
  hourlyWage      Decimal?        @db.Decimal(10, 2)
  basePay         Decimal         @db.Decimal(12, 2)
  positionBase    Decimal         @db.Decimal(12, 2)
  joinedOn        DateTime        @db.Date
  leftOn          DateTime?       @db.Date
  evaluationCycle EvaluationCycle
  status          MemberStatus    @default(在籍)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  evaluations  MonthlyEvaluation[]
  bonusRecords BonusDigRecord[]
  loans        Loan[]              @relation("borrower")
  paidTxns     Transaction[]       @relation("payer")
  receivedTxns Transaction[]       @relation("payee")

  @@index([division])
  @@index([groupLeaderId])
}

/// 月次評価（要件 F-7）。確定後はイミュータブル（値凍結・F-9）。
model MonthlyEvaluation {
  yearMonth String
  personId  String
  member    Member @relation(fields: [personId], references: [personId])

  // 取込時に凍結する値
  division       String
  employmentType EmploymentType
  positionBase   Decimal        @db.Decimal(12, 2)
  joinedOn       DateTime       @db.Date
  leftOn         DateTime?      @db.Date

  // 計算結果
  residencyDays        Int
  prorationCoefficient Decimal @db.Decimal(6, 4)
  seatCost             Decimal @db.Decimal(12, 2)
  totalCost            Decimal @db.Decimal(14, 2)
  monthlyBudgetDig     Decimal @db.Decimal(14, 2)
  cumulativeBudgetDig  Decimal @db.Decimal(16, 2)

  // 実績（成果Dig=獲得粗利は手入力・v1.1 Q3）
  seikaDig Decimal @db.Decimal(14, 2)
  bonusDig Decimal @db.Decimal(14, 2) @default(0)
  loanDig  Decimal @db.Decimal(14, 2) @default(0)

  // 単月
  monthlyActualDig Decimal @db.Decimal(14, 2)
  monthlyRate      Decimal @db.Decimal(8, 4)
  monthlyRank      Rank
  // 累計
  cumulativeActualDig Decimal @db.Decimal(14, 2)
  cumulativeRate      Decimal @db.Decimal(8, 4)
  cumulativeRank      Rank

  finalized Boolean  @default(false)
  createdAt DateTime @default(now())

  // Q3: 超過分の処理選択（incentive=インセン / carryover=翌期持越）
  surplusChoice   String  @default("incentive")
  // Q13: 成果Dig手入力の承認（自動計上=承認済 / 手入力=要承認）
  seikaApproved   Boolean @default(true)
  seikaInputBy    String?
  seikaApprovedBy String?

  @@id([yearMonth, personId])
  @@index([yearMonth])
}

/// 退社時の借入残高精算（Q14・グループ負担割合・相殺）
model RetirementSettlement {
  id          Int      @id @default(autoincrement())
  personId    String
  yearMonth   String
  loanBalance Decimal  @db.Decimal(14, 2)
  shares      Json // [{personId, amount}] グループ内の負担配分
  note        String?
  settledBy   String
  createdAt   DateTime @default(now())

  @@index([personId])
}

/// ボーナスDig項目マスタ（要件 F-4）
model BonusDigItem {
  itemId       String   @id
  category     String
  name         String
  grantDig     Decimal  @db.Decimal(12, 2)
  monthlyCapDig Decimal @db.Decimal(12, 2)
  description  String?
  enabled      Boolean  @default(true)

  records BonusDigRecord[]
}

/// ボーナスDig記録（要件 F-4）
model BonusDigRecord {
  id         Int      @id @default(autoincrement())
  yearMonth  String
  recordedOn DateTime @db.Date
  personId   String
  member     Member   @relation(fields: [personId], references: [personId])
  itemId     String
  item       BonusDigItem @relation(fields: [itemId], references: [itemId])
  grantedDig Decimal  @db.Decimal(12, 2)
  note       String?

  @@index([yearMonth, personId])
}

/// 借入管理 / Digloss Bank・ディグロス金融（要件 F-5・v1.2）
model Loan {
  id          Int        @id @default(autoincrement())
  yearMonth   String
  borrowerId  String
  borrower    Member     @relation("borrower", fields: [borrowerId], references: [personId])
  lender      String // "ディグロス金融" or Person ID
  loanType    LoanType   @default(追加)
  status      LoanStatus @default(申請中)
  principal   Decimal    @db.Decimal(14, 2)
  monthlyRate Decimal    @db.Decimal(6, 4) // 借入時レートを固定保持
  termMonths  Int
  appliedOn   DateTime   @db.Date
  approvedBy  String? // 承認者(金融)。初回は自動承認
  approvedOn  DateTime?  @db.Date
  reason      String?
  note        String?
  createdAt   DateTime   @default(now())

  messages    LoanMessage[]
  attachments LoanAttachment[]
  reads       LoanRead[]

  @@index([borrowerId])
  @@index([yearMonth])
  @@index([status])
}

/// 借入申請のチャット（コメント・差し戻し・否決・承認の履歴）
model LoanMessage {
  id         Int      @id @default(autoincrement())
  loanId     Int
  loan       Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  authorId   String // アカウントID
  authorName String
  kind       String   @default("comment") // apply/comment/approve/reject/return
  body       String
  createdAt  DateTime @default(now())

  @@index([loanId])
}

/// 借入申請の添付（事業計画など・銀行借入のように）
model LoanAttachment {
  id         Int      @id @default(autoincrement())
  loanId     Int
  loan       Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  fileName   String
  category   String   @default("事業計画") // 事業計画/その他
  note       String?
  url        String? // 実ファイル格納は後続（現状はメタデータ）
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([loanId])
}

/// スレッド既読管理（未読バッジ算出用）
model LoanRead {
  loanId     Int
  accountId  String
  lastReadAt DateTime @default(now())
  loan       Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@id([loanId, accountId])
}

/// 取引記録 / メンバー間送金（要件 F-6）
model Transaction {
  id          Int      @id @default(autoincrement())
  yearMonth   String
  tradedOn    DateTime @db.Date
  payerId     String
  payer       Member   @relation("payer", fields: [payerId], references: [personId])
  payeeId     String
  payee       Member   @relation("payee", fields: [payeeId], references: [personId])
  amount      Decimal  @db.Decimal(14, 2)
  description String
  note        String?
  createdAt   DateTime @default(now())

  @@index([yearMonth])
}
